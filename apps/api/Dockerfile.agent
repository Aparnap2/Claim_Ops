# ClaimOps Agent — cognitive boundary (Cloud Run).
# Same hardening as API: static binary, Alpine runtime, non-root.
FROM golang:1.27-alpine AS build
RUN apk add --no-cache git ca-certificates
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/agent ./cmd/agent \
 && ls -la /out/agent

FROM alpine:3.21
RUN apk add --no-cache ca-certificates \
 && adduser -D -H -u 10001 apprunner \
 && rm -rf /var/cache/apk/*
WORKDIR /app
COPY --from=build /out/agent /app/agent
ENV PORT=8081 APP_ENV=prod AGENT_PORT=8081
EXPOSE 8081
USER apprunner
ENTRYPOINT ["/app/agent"]
